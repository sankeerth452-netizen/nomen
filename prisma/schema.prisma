generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner // platform operator: manages all brands and users
  admin // brand admin: datasets, brand settings, history
  buyer // names and edits products (the same as editor; kept for existing logins)
  editor // names and edits products, sends them for approval
  reviewer // approves or rejects products, comments
}

/// Where a named product stands before it goes to the website or Google.
enum ReviewStatus {
  pending
  ai_generated
  needs_review
  approved
  rejected
  ready_to_export
  published
}

enum DatasetStatus {
  uploading
  validating
  ready
  active
  failed
  archived
}

enum FeedbackOutcome {
  used
  edited
  rejected
}

model Brand {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  country                String   @default("AU")
  language               String   @default("en")
  settings               Json     @default("{}")
  activeKeywordDatasetId String?  @unique
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users         User[]
  datasets      KeywordDataset[] @relation("BrandDatasets")
  activeDataset KeywordDataset?  @relation("ActiveDataset", fields: [activeKeywordDatasetId], references: [id])
  generations   Generation[]
  auditEvents   AuditEvent[]
  batches       Batch[]
  feedColumns   FeedColumn[]
  reviews       ProductReview[]
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique // stored lowercase; assigned by the owner, never self-service
  displayName    String
  email          String?
  passwordHash   String
  role           Role      @default(buyer)
  brandId        String?
  active         Boolean   @default(true)
  // Bump to invalidate every session this user holds (password reset, disable, forced logout)
  sessionVersion Int       @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand       Brand?       @relation(fields: [brandId], references: [id])
  generations Generation[]
  feedback    Feedback[]
  auditEvents AuditEvent[]
  batches     Batch[]
  revisions   ReviewRevision[]
  comments    ReviewComment[]

  @@index([brandId])
}

model KeywordDataset {
  id                String        @id @default(uuid())
  brandId           String
  name              String
  originalFilename  String?
  status            DatasetStatus @default(uploading)
  rowsAccepted      Int           @default(0)
  rowsRejected      Int           @default(0)
  rowsDuplicate     Int           @default(0)
  validationSummary Json          @default("{}")
  uploadedById      String?
  createdAt         DateTime      @default(now())
  activatedAt       DateTime?

  brand      Brand              @relation("BrandDatasets", fields: [brandId], references: [id])
  activeFor  Brand?             @relation("ActiveDataset")
  keywords   Keyword[]
  rejections DatasetRejection[]

  @@index([brandId, status])
}

model Keyword {
  id                String    @id @default(uuid())
  datasetId         String
  originalKeyword   String
  normalizedKeyword String
  searchVolume      Int?
  category          String?
  subcategory       String?
  competition       Float?
  cpc               Float?
  intent            String?
  country           String?
  language          String?
  source            String?
  sourceUpdatedAt   DateTime?
  metadata          Json      @default("{}")

  dataset KeywordDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  // The full-text index is an expression index made in raw SQL (Prisma can't express it, and leaves it alone).
  // The trigram index must be declared here: left out, a schema-generated migration drops it (20261005123050 did,
  // and every keyword search then read the whole table: names took 60-85 s once Nitin's 238k-row list was in).
  @@unique([datasetId, normalizedKeyword, country, language])
  @@index([datasetId])
  @@index([normalizedKeyword(ops: raw("gin_trgm_ops"))], type: Gin, map: "Keyword_trgm_idx")
}

model Generation {
  id                String   @id @default(uuid())
  brandId           String
  userId            String
  datasetId         String?
  originalInput     Json
  extractedFacts    Json?
  candidateEvidence Json?
  selectedQueries   Json?
  result            Json?
  confidence        String?
  status            String   @default("pending")
  errorCode         String?
  promptVersions    Json?
  modelName         String?
  durationMs        Int?
  usage             Json?
  /// What each of the piece's photos shows, its alt text and any problems found ([{ position, view, alt, problems }])
  photos            Json?
  /// A test, not real work: left out of the dashboard unless tests are asked for
  isTest            Boolean  @default(false)
  /// The piece's page on the brand's site (from its product file, or entered on Review), for Google's figures
  liveUrl           String?
  /// When the new name went live on that page: the line between "before" and "after"
  liveSince         DateTime?
  /// The name the page had before (from the product file, or entered), to show beside the new one
  previousTitle     String?
  createdAt         DateTime @default(now())

  brand     Brand            @relation(fields: [brandId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  feedback  Feedback[]
  photo     GenerationPhoto?
  batchItem BatchItem?
  review    ProductReview?
  images    ProductImage[]
  metrics   PageMetric[]
  queries   PageQuery[]
  merchant  MerchantStatus?

  @@index([brandId, createdAt])
  @@index([userId, createdAt])
}

/// The buyer's product photo, kept small (a display thumbnail) so results and History show the real piece.
model GenerationPhoto {
  generationId String     @id
  mediaType    String
  data         Bytes
  /// Where the piece sits in the photo ({left, top, right, bottom} as fractions), so screens can frame it.
  focus        Json?
  createdAt    DateTime   @default(now())
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
}

model SerpCache {
  id              String   @id @default(uuid())
  cacheKey        String   @unique
  query           String
  location        String
  language        String
  device          String
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime
  reducedResponse Json
  providerStatus  String?
  costUsd         Float?

  @@index([expiresAt])
}

model Feedback {
  id           String          @id @default(uuid())
  generationId String
  userId       String
  outcome      FeedbackOutcome
  finalTitle   String?
  reason       String?
  createdAt    DateTime        @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([generationId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  brandId    String?
  userId     String?
  eventType  String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  brand Brand? @relation(fields: [brandId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([brandId, createdAt])
}

model DatasetRejection {
  id        String  @id @default(uuid())
  datasetId String
  rowNumber Int
  keyword   String?
  reason    String
  raw       Json    @default("{}")

  dataset KeywordDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

/// A named product's review: its status, the values people changed (the AI's own stay in Generation.result), and
/// which fields have been approved or rejected.
model ProductReview {
  id           String       @id @default(uuid())
  generationId String       @unique
  brandId      String
  status       ReviewStatus @default(ai_generated)
  /// Field -> the value a person set; a field not here shows what the AI wrote
  edits        Json         @default("{}")
  /// Field -> "approved" | "rejected"
  fieldStatus  Json         @default("{}")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  generation Generation       @relation(fields: [generationId], references: [id], onDelete: Cascade)
  brand      Brand            @relation(fields: [brandId], references: [id])
  revisions  ReviewRevision[]
  comments   ReviewComment[]

  @@index([brandId, status, updatedAt])
}

/// Every change to a reviewed product, for its history and to restore: a field's new value (or "status"), who, when.
model ReviewRevision {
  id        String   @id @default(uuid())
  reviewId  String
  field     String
  /// "human" (a person's edit), "restore" (an earlier value brought back) or "status"
  source    String
  value     Json
  userId    String?
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])

  @@index([reviewId, field, createdAt])
}

/// A reviewer's or editor's note on a product (or one field of it). `flag` marks the AI as wrong, for improving it.
model ReviewComment {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  field     String?
  body      String
  flag      Boolean  @default(false)
  createdAt DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([reviewId, createdAt])
}

/// Google's product categories (taxonomy-with-ids.en-AU.txt). Loaded from the copy in prisma/data on deploy, and
/// updatable from Google by the owner, so checks never rely on an out-of-date list in the code.
model GoogleCategory {
  id        Int      @id
  path      String
  updatedAt DateTime @default(now()) @updatedAt
}

/// What one column in a brand's product files is (as the buyer confirmed it), remembered for the brand's next upload.
model FeedColumn {
  brandId   String
  /// The header, normalised ("product code", "item colour")
  header    String
  target    String
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([brandId, header])
}

/// A range: many product photos a buyer names together.
model Batch {
  id        String   @id @default(uuid())
  brandId   String
  userId    String
  title     String
  /// "photos" (dropped photos) or "file" (started from the brand's product file)
  source    String   @default("photos")
  fileName  String?
  /// Checks on the brand's product file: required fields, stock and price values, variants ({ rows, products, issues })
  fileCheck Json?
  /// A test range, not real work: its pieces are left out of the dashboard unless tests are asked for
  isTest    Boolean  @default(false)
  createdAt DateTime @default(now())

  brand Brand       @relation(fields: [brandId], references: [id])
  user  User        @relation(fields: [userId], references: [id])
  items BatchItem[]

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
}

/// One photo in a range. Claude reads it, the buyer checks what it showed, then it is named like any other piece.
/// status: queued -> reading -> review (or not_product / read_failed); review -> to_name -> naming -> named / needs_input / failed
model BatchItem {
  id           String    @id @default(uuid())
  batchId      String
  position     Int
  filename     String
  status       String    @default("queued")
  photo        Bytes? // the copy kept for screens (900px); for a product-file piece, filled once its image link is read
  photoType    String?
  /// A product-file piece's image_link, read like a dropped photo
  imageUrl     String?
  /// A product-file piece's rows from the brand's file (one per size or SKU), passed through untouched
  feed         Json?
  readImage    Bytes? // the larger copy Claude reads (1568px); cleared once read
  /// What reading the photo cost (model and tokens), so a range's cost includes it
  readUsage    Json?
  readType     String?
  details      Json? // the form fields the photo filled in, as the buyer has checked them
  focus        Json?
  generationId String?   @unique
  attempts     Int       @default(0)
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  batch      Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  images     ProductImage[]

  @@index([batchId, position])
  @@index([status, updatedAt])
}

/// More photos of a piece besides its main one (back, side, details), read together with it. The main photo stays
/// where it always was (BatchItem.photo, GenerationPhoto). What each photo shows, its alt text and any problems are
/// kept with the piece's details (BatchItem.details.photos) and, once named, its result (Generation.result.photos).
model ProductImage {
  id           String      @id @default(uuid())
  batchItemId  String?
  generationId String?
  /// 1, 2, ... in the order the brand gave them (the main photo is 0)
  position     Int
  /// From a product file (additional_image_link, or Shopify's extra image rows); fetched when the piece is read
  url          String?
  /// The copy kept for screens (900px)
  photo        Bytes?
  photoType    String?
  /// The larger copy Claude reads (1568px); cleared once read
  readImage    Bytes?
  readType     String?
  createdAt    DateTime    @default(now())

  batchItem  BatchItem?  @relation(fields: [batchItemId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([batchItemId, position])
  @@index([generationId, position])
}

/// Every paid call, one row each, so spend can be shown by day, brand, range and step. Prices are the providers' list
/// prices at the time (Claude per token; DataForSEO as charged). `backfilled`: a product named before this ledger
/// existed, recorded as one total ("all_steps") from what it had stored.
model UsageEvent {
  id           String   @id @default(uuid())
  brandId      String?
  userId       String?
  generationId String?
  batchId      String?
  /// details, name, page, data, google_results, keyword_figures, photo_read, brand_voice, seasonal_figures, all_steps
  operation    String
  /// claude or dataforseo
  provider     String
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheRead    Int      @default(0)
  cacheWrite   Int      @default(0)
  costUsd      Float    @default(0)
  backfilled   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([brandId, createdAt])
  @@index([generationId])
  @@index([batchId])
}

/// A brand's read-only Google connection: Search Console, Analytics and Merchant Center. The refresh token is
/// encrypted (AES-256-GCM); the brand chooses which site, property and account to read.
model GoogleConnection {
  brandId           String    @id
  email             String?
  scopes            String[]
  /// Encrypted refresh token ("iv.tag.data", base64)
  refreshToken      String
  /// e.g. "sc-domain:sportsgirl.com.au" or "https://www.sportsgirl.com.au/"
  searchConsoleSite String?
  /// e.g. "properties/123456789"
  analyticsProperty String?
  /// e.g. "accounts/123456789"
  merchantAccount   String?
  connectedById     String?
  lastSyncAt        DateTime?
  lastSyncError     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// One day of Google's figures for a named piece's live page, from one source (search_console, analytics, merchant).
model PageMetric {
  id           String     @id @default(uuid())
  brandId      String
  generationId String
  date         DateTime   @db.Date
  source       String
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  /// Average position that day (Search Console); weighted by impressions when combined
  position     Float?
  views        Int        @default(0)
  sessions     Int        @default(0)
  addToCarts   Int        @default(0)
  purchases    Int        @default(0)
  revenue      Float      @default(0)
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, date, source])
  @@index([brandId, date])
}

/// The searches a live page showed up for in Google (Search Console, the 28 days before the last sync).
model PageQuery {
  generationId String
  query        String
  impressions  Int
  clicks       Int
  position     Float?
  syncedAt     DateTime   @default(now())
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, query])
}

/// Google Shopping's verdict on a piece's products (Merchant Center): approved, or the issues holding it back.
model MerchantStatus {
  generationId String     @id
  /// approved, partly approved, disapproved or pending
  status       String
  issues       Json       @default("[]")
  syncedAt     DateTime   @default(now())
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
}
